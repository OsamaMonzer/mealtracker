# Supabase — required for live sync + Vercel production database
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Database connection — required for API routes on Vercel
# Get from: Supabase Dashboard → Project Settings → Database → Connection string → URI (Transaction pooler)
POSTGRES_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Alternative names also supported:
# DATABASE_URL=
# SUPABASE_DB_URL=

# Service-role key — server only (weight photos + API-key calls). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# API key for the iPhone Shortcut / custom GPT / MCP. Required for those to work (min 16 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MEALTRACKER_API_KEY=
# Which account API-key calls act as (your Supabase auth user id)
MEALTRACKER_API_USER_ID=

# Timezone used for "today" when the client doesn't send a date (GPT / MCP / Shortcut)
APP_TIMEZONE=Asia/Kuala_Lumpur
